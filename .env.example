# =====================================================================
# REOWN 환경변수 템플릿
# ---------------------------------------------------------------------
# 이 파일을 복사해 .env를 만들고 값을 채운다.  (cp .env.example .env)
# 이 파일에는 실제 비밀번호나 키를 절대 적지 않는다. (CLAUDE.md 9장)
# GitHub에는 이 파일만 올린다. 실제 값은 .env에만 넣는다. (.env는 .gitignore로 제외)
# 실제 값은 DB 관리자에게 비공개로 전달받는다. 팀원은 Supabase 대시보드에 접근하지 않는다.
#   DB 접속 안내: docs/DB_CONNECTION.md
#
# 아래 값은 모두 백엔드 전용이다.
# - 이름에 VITE_ 접두사를 붙이지 않는다. VITE_ 변수는 프론트엔드 번들에 그대로 포함된다.
# - 프론트엔드에는 Supabase 키를 넣지 않는다. (docs/DATABASE.md 4.2)
# =====================================================================

# ---------------------------------------------------------------------
# Supabase PostgreSQL — 백엔드 pg 연결 (D6)
# Session pooler 연결 문자열 사용 (IPv4 지원, 트랜잭션 사용 가능). DB 관리자에게 전달받는다.
# 형식: postgresql://postgres.<project-ref>:<DB 비밀번호>@aws-0-<region>.pooler.supabase.com:5432/postgres
# 비밀번호에 특수문자가 있으면 URL 인코딩한다. (예: @ → %40, # → %23)
# ---------------------------------------------------------------------
DATABASE_URL=

# 백엔드 서버 포트
PORT=4000

# 허용할 프론트엔드 주소. 여러 개면 쉼표로 구분한다.
FRONTEND_URL=http://localhost:5173

# ---------------------------------------------------------------------
# Supabase Storage — 상품 이미지 업로드 전용 (supabase-js, 백엔드에서만 사용)
# DB 관리자에게 전달받는다.
# SERVICE_ROLE_KEY는 RLS를 무시하는 관리자 키다. 프론트엔드·Git·채팅에 노출 금지.
# ---------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------
# 인증 (JWT, D2: Access Token만 사용)
# 32바이트 이상 무작위 문자열. 생성 예: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# ---------------------------------------------------------------------
JWT_SECRET=
JWT_EXPIRES_IN=2h

# ---------------------------------------------------------------------
# 외부 API — 카카오 주소/지도
# ---------------------------------------------------------------------
KAKAO_API_KEY=
