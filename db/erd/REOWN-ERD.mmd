    users ||--o{ reviews : "reviewer_id (RESTRICT)"
    users ||--o{ reports : "reported_user_id (RESTRICT)"
    users ||--o{ reports : "reporter_id (RESTRICT)"
    users ||--o{ blocks : "blocked_id (CASCADE)"
    users ||--o{ blocks : "blocker_id (CASCADE)"
    users ||--o{ notifications : "user_id (CASCADE)"
    products ||--o{ product_images : "product_id (CASCADE)"
    products ||--o{ favorites : "product_id (CASCADE)"
    products ||--o{ cart : "product_id (CASCADE)"
    products ||--o{ chat_rooms : "product_id (RESTRICT)"
    products |o--o{ reports : "product_id (RESTRICT)"
    chat_rooms ||--o{ messages : "chat_room_id (RESTRICT)"
